# 1. IP-BASED ROUTING (PORT 80)
# Serves the Angular frontend and proxies API requests to the active backend port
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root {{ app_root }}/frontend/current;
    index index.html;

    # Strip trailing dot from hostname (fixes chrome-error issue)
    if ($http_host ~* "^(.*?)\.$") {
        return 301 $scheme://$1$request_uri;
    }

    # SPA Angular Routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API Proxy to Java backend (running on active port)
    location /api/ {
        proxy_pass http://127.0.0.1:{{ active_port | default(8080) }}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
